# ============================================================
#  GamerBazar.ge — .env კონფიგურაცია
#  დააკოპირე .env სახელით და შეავსე შენი მონაცემებით
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
# Supabase-ში: Settings → Database → Connection String → URI
# Railway-ში:  Variables-ში DATABASE_URL ავტომატ. ჩნდება
DATABASE_URL=postgresql://postgres:ᲨᲔᲜᲘ_ᲞᲐᲠᲝᲚᲘ@db.XXXXX.supabase.co:5432/postgres

# ── JWT ─────────────────────────────────────────────────────
# გენ.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=აქ_32_სიმბოლო_მინიმუმ_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Frontend URL (CORS) ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── File Upload (სურვ.) ──────────────────────────────────────
MAX_FILE_SIZE_MB=2
UPLOAD_DIR=./uploads

# ── Web Push (VAPID keys) ──────────────────────────────────────
# გენ.: npm run vapid-keys
VAPID_PUBLIC_KEY=BJrE4aCCsGLsTVI0h83S_OaPUcbFdRoViKbPEKlC-UkIrzY5ihRYQ8jpT-qbmgJVRSu9Ftc6IdLVVLodAfUMRM4
VAPID_PRIVATE_KEY=GlkWW5s5-QKhsmAyqJ3hRKSPqhvDiLIncO1s24OvlWY
VAPID_SUBJECT=mailto:admin@gamerbazar.ge

# ── Email (Gmail SMTP + nodemailer) ────────────────────────────
# Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
